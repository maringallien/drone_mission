<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_mission</name>
  <version>0.1.0</version>
  <description>PX4 offboard mission server (arm, takeoff, fly geometric patterns, land) and an interactive CLI client.</description>
  <maintainer email="gallienmarin2001@gmail.com">Marin Gallien</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>px4_msgs</depend>
  <depend>drone_mission_interfaces</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
